{
  "type": "json_schema",
  "name": "full_factuality_v2",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "claims": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "claim": {"type": "string"},
            "summary_quote": {"type": "string"},
            "verdict": {"type": "string", "enum": ["supported", "contradicted", "not_established"]},
            "source_quote": {"type": "string"},
            "error_type": {"type": "string", "enum": ["none", "insertion", "substitution", "actor", "scope", "modality", "quantity_date", "condition_exception", "other"]},
            "rationale": {"type": "string"}
          },
          "required": ["claim", "summary_quote", "verdict", "source_quote", "error_type", "rationale"],
          "additionalProperties": false
        }
      }
    },
    "required": ["claims"],
    "additionalProperties": false
  }
}
