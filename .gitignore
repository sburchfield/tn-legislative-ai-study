# API keys / secrets — never commit these
.env
.env.*
*.pem

# Go build artifacts
/scripts/export/export
/scripts/cleaning/cleaning
*.exe
*.test

# Dataset exports.
# The reviewed 114th GA corpus (data/raw/bills.jsonl, data/cleaned/bills.jsonl,
# data/cleaned/dataset-stats.json) is committed intentionally. Any other/future
# export (e.g. a different session, or a scratch/test run) stays ignored by
# default; see docs/dataset.md for how to regenerate or add one.
/data/raw/*.jsonl
/data/cleaned/*.jsonl
/data/cleaned/dataset-stats.json
!/data/raw/.gitkeep
!/data/cleaned/.gitkeep
!/data/raw/bills.jsonl
!/data/cleaned/bills.jsonl
!/data/cleaned/dataset-stats.json

# OS cruft
.DS_Store
